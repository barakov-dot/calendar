# Скопируйте в .env и замените заглушки. Файл .env в git не коммитится.

# База данных. Пароль должен совпадать в POSTGRES_PASSWORD и DATABASE_URL.
# Сгенерировать: openssl rand -hex 24
POSTGRES_USER=buh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=buh
DATABASE_URL=postgresql+asyncpg://buh:change_me@db:5432/buh

# Токен от @BotFather
BOT_TOKEN=
# Ключ подписи входа, не короче 32 символов. Без него войти нельзя.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
# Числовой Telegram ID администратора: создаётся при старте api
ADMIN_TELEGRAM_ID=

# dev | prod. В docker-compose.dev.yml / .prod.yml задаётся принудительно.
APP_ENV=dev
# Прод: где контейнер web принимает запросы вашего nginx (HTTP).
# 127.0.0.1 — nginx стоит на этом же сервере. Если на другой машине или в отдельной
# Docker-сети, укажите внутренний IP сервера и закройте порт снаружи файрволом.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

SETTINGS_PATH=/app/config/settings.json

# Запасной прокси для первого запуска, например socks5://user:password@host:1080
TELEGRAM_PROXY_URL=

# Резервные копии (прод): сколько дней хранить и куда копировать вне сервера (rsync).
BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=

# UID/GID пользователя внутри backend-контейнеров. На Ubuntu укажите вывод `id -u` и `id -g`,
# чтобы контейнеры могли писать в ./config, а вы — редактировать settings.json.
APP_UID=1000
APP_GID=1000
