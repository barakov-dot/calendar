# APP_DOMAIN берётся из .env. Для домена Caddy сам получает HTTPS-сертификат.
{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	# Файлы сборки содержат хэш в имени и кэшируются надолго.
	# Отсутствующий файл — это 404, а не index.html.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
